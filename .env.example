# Copy to .env (never commit .env). `go run ./examples/notes check-config` lists every variable.
APP_PUBLIC_URL=http://localhost:8080
APP_HTTP_ADDR=127.0.0.1:8080
APP_DATABASE_URL=postgres://core:core@127.0.0.1:55532/core
# Generate with: openssl rand -base64 32
APP_MASTER_KEY=
APP_TENANCY=single
APP_SIGNUP=invite
APP_LOG_FORMAT=text
